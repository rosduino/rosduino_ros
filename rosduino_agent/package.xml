<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosduino_agent</name>
  <version>0.1.0</version>
  <description>ROS 2 serial-to-DDS bridge agent for RosDuino microcontrollers.</description>
  <maintainer email="maintainers@voltbro.com">RosDuino Contributors</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/rosduino/rosduino_ros</url>
  <url type="bugtracker">https://github.com/rosduino/rosduino_ros/issues</url>
  <url type="repository">https://github.com/rosduino/rosduino_ros</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rcpputils</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>example_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
