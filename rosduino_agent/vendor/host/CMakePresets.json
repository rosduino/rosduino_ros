{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug (ASan + UBSan + Tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/cmake/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROSDUINO_BUILD_TESTS": "ON",
        "ROSDUINO_BUILD_FUZZ": "OFF",
        "ROSDUINO_SANITIZE": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/cmake/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROSDUINO_BUILD_TESTS": "OFF",
        "ROSDUINO_BUILD_FUZZ": "OFF",
        "ROSDUINO_SANITIZE": "OFF"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer (Docker clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/cmake/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROSDUINO_BUILD_TESTS": "OFF",
        "ROSDUINO_BUILD_FUZZ": "ON",
        "ROSDUINO_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
