<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosduino</name>
  <version>0.1.0</version>
  <description>Metapackage for RosDuino ROS 2 packages (agent and message generator).</description>
  <maintainer email="maintainers@rosduino.org">RosDuino Contributors</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rosduino_agent</exec_depend>
  <exec_depend>rosduino_gen</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
